<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.tripshare.controlador.PrimaryController"
           style="-fx-background-color: #F3F6FA;">

    <children>

        <VBox spacing="35" alignment="TOP_CENTER">

            <padding>
                <Insets top="25" right="45" bottom="40" left="45"/>
            </padding>

            <!-- Cabecera -->
            <HBox alignment="CENTER_LEFT" spacing="10">

                <Label text="✈"
                       style="-fx-font-size: 30px; -fx-text-fill: #3978B9;"/>

                <Label text="TripShare"
                       style="-fx-font-size: 25px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #263D59;"/>

            </HBox>

            <VBox alignment="CENTER" spacing="10"
                  maxWidth="430"
                  style="-fx-background-color: white;
                         -fx-background-radius: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 18, 0, 0, 4);">

                <padding>
                    <Insets top="40" right="40" bottom="40" left="40"/>
                </padding>

                <Label text="¡Bienvenido a TripShare!"
                       style="-fx-font-size: 25px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #263D59;"/>

                <Label text="Organiza tus viajes y comparte experiencias"
                       wrapText="true"
                       style="-fx-font-size: 13px;
                              -fx-text-fill: #78889A;"/>

                <VBox spacing="8">
                    <padding>
                        <Insets top="25"/>
                    </padding>

                    <Label text="Correo electrónico"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #34495E;"/>

                    <TextField fx:id="emailField"
                               promptText="Introduce tu correo electrónico"
                               prefHeight="43"
                               style="-fx-background-color: #F7F9FC;
                                      -fx-border-color: #DCE4ED;
                                      -fx-border-radius: 7;
                                      -fx-background-radius: 7;"/>

                    <Label text="Contraseña"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #34495E;"/>

                    <PasswordField fx:id="passwordField"
                                   promptText="Introduce tu contraseña"
                                   prefHeight="43"
                                   style="-fx-background-color: #F7F9FC;
                                          -fx-border-color: #DCE4ED;
                                          -fx-border-radius: 7;
                                          -fx-background-radius: 7;"/>

                </VBox>

                <Button fx:id="loginButton"
                        text="Iniciar sesión"
                        onAction="#iniciarSesion"
                        maxWidth="Infinity"
                        prefHeight="45"
                        style="-fx-background-color: #3978B9;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"/>

                <HBox alignment="CENTER" spacing="5">
                    <Label text="¿No tienes una cuenta?"
                           style="-fx-text-fill: #78889A;
                                  -fx-font-size: 12px;"/>

                    <Button fx:id="registerButton"
                            text="Regístrate"
                            onAction="#registrarse"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #3978B9;
                                   -fx-font-weight: bold;
                                   -fx-cursor: hand;"/>
                </HBox>

            </VBox>

            <Label text="© 2026 TripShare. Todos los derechos reservados."
                   style="-fx-text-fill: #A0AAB5;
                          -fx-font-size: 11px;"/>

        </VBox>

    </children>

</StackPane>
