<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tripshare.controlador.MisViajesController"
            prefWidth="1000.0"
            prefHeight="700.0"
            style="-fx-background-color: #F3F6FA;">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT"
                  spacing="12"
                  style="-fx-background-color: white; -fx-padding: 18 45 18 45;">

                <Label text="✈"
                       style="-fx-font-size: 27px; -fx-text-fill: #2878D0;"/>

                <Label text="TripShare"
                       style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #25364A;"/>

                <HBox HBox.hgrow="ALWAYS"/>

                <Label text="Mis viajes"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2878D0;"/>

                <Label text="Mi perfil"
                       style="-fx-font-size: 14px; -fx-text-fill: #64748B;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT"
                  style="-fx-background-color: #E8F1FC; -fx-padding: 30 55 30 55;">

                <VBox spacing="7">
                    <Label fx:id="saludoLabel"
                           text="¡Hola!"
                           style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #25364A;"/>

                    <Label text="Organiza tus aventuras y comparte experiencias."
                           style="-fx-font-size: 14px; -fx-text-fill: #64748B;"/>
                </VBox>

                <HBox HBox.hgrow="ALWAYS"/>

                <Button text="+ Crear viaje"
                        onAction="#crearViaje"
                        style="-fx-background-color: #2878D0; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 9; -fx-padding: 12 22 12 22; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 30 55 35 55;">

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label text="Mis viajes"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #25364A;"/>

                    <Label text="Aquí encontrarás todos tus viajes."
                           style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                </VBox>
            </HBox>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        style="-fx-background-color: transparent; -fx-background: transparent;">

                <content>
                    <FlowPane fx:id="viajesContainer"
                              hgap="20"
                              vgap="20"
                              prefWrapLength="850"
                              style="-fx-background-color: transparent;"/>
                </content>
            </ScrollPane>

            <Label fx:id="mensajeVacioLabel"
                   text="Todavía no tienes viajes. ¡Crea tu primera aventura!"
                   visible="false"
                   managed="false"
                   style="-fx-font-size: 14px; -fx-text-fill: #718096; -fx-padding: 20 0 0 0;"/>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER"
              style="-fx-background-color: white; -fx-padding: 15;">

            <Label text="© 2026 TripShare - Viajar es mejor compartido"
                   style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
        </HBox>
    </bottom>

</BorderPane>
